# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Secrets and signing material — never committed (CLAUDE.md Article 5).
# Configuration reaches the app through --dart-define, not through files.
.env
.env.*
*.jks
*.keystore
*.p12
*.mobileprovision
/android/key.properties
/ios/Runner/GoogleService-Info.plist
/android/app/google-services.json
# Firebase client values for --dart-define-from-file (decision D-185). Public
# identifiers, still never committed. Only the empty example is tracked.
/env/firebase.*.json
!/env/firebase.example.json

# Local release-signing copies. The *.example files are tracked.
# The keystore itself must live outside this repository; see
# android/key.properties.example.
/ios/ExportOptions.plist
/ios/Flutter/Release-Signing.xcconfig

# Local design PNGs for golden comparison. Not shipped.
/design-refs/

# Redesign hand-off pack (design/README.md, mock-ups). Reference only; Phase 5 copies
# what stays into docs/design/.
/design/
