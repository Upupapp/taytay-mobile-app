  "networkUnreachableTitle": "Not reaching Taytay LGU",
  "@networkUnreachableTitle": {
    "description": "Offline banner heading. Deliberately not 'you appear to be offline' — that is a guess about the resident's phone, where this is what the app actually knows."
  },
  "networkUnreachableMessage": "The app cannot get through right now. Anything you have typed is still here.",
  "@networkUnreachableMessage": {
    "description": "Offline banner body. Says only what the app knows about the connection and never what happened to a send: the failures that raise the banner include timeouts and connections that dropped after the request left the phone, which the office may already hold. Each send says for itself whether it went (D-188, D-189). The Filipino text was reviewed for grammar and consistency in D-217, not by a native speaker; a native Filipino speaker from the MSWDO should still read it during UAT."
  },
  "unsentTitle": "Not confirmed yet",
  "@unsentTitle": {
    "description": "Heading for work the resident finished that the office has not confirmed it has. Never translate this as 'saved': a resident who reads 'saved' believes the office has it and stops chasing it. Not 'not sent' either: a send that timed out may have reached the office (D-188, D-191). The Filipino text was reviewed for grammar and consistency in D-217, not by a native speaker; a native Filipino speaker from the MSWDO should still read it during UAT."
  },
  "unsentMessage": "We could not confirm that Taytay LGU has {what}. Everything you typed is still on this phone.",
  "@unsentMessage": {
    "description": "Body for work whose send failed. True whether the send never left the phone or its answer was lost, so it never says nothing was filed (D-188, D-191). The Filipino text was reviewed for grammar and consistency in D-217, not by a native speaker; a native Filipino speaker from the MSWDO should still read it during UAT.",
    "placeholders": {
      "what": {
        "type": "String",
        "example": "your application"
      }
    }
  },
  "unsentResendSafe": "Sending it again is safe: it will not be filed twice.",
  "@unsentResendSafe": {
    "description": "Added after unsentMessage only when the send keeps its idempotency key for the retry, the one case where a second send cannot file twice (D-191). The Filipino text was reviewed for grammar and consistency in D-217, not by a native speaker; a native Filipino speaker from the MSWDO should still read it during UAT."
  },
  "staleContentMessage": "Showing what was saved on {timestamp}. It may have changed.",
