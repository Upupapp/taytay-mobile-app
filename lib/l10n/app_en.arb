  "profPrivacyResponsibleTitle": "Taytay LGU is responsible for your information",
  "@profPrivacyResponsibleTitle": {
    "description": "Heading of the privacy notice panel. The Filipino text was written by Claude for D-237, following the terms of app_fil.arb, not by a native speaker; a native Filipino speaker from the MSWDO should still read it during UAT."
  },
  "profPrivacyResponsibleIntro": "This app is one way to reach the Municipality of Taytay, Rizal. Your information belongs to your municipal record, not to the app on your phone.",
  "@profPrivacyResponsibleIntro": {
    "description": "Intro of the privacy notice panel. The Filipino text was written by Claude for D-237, following the terms of app_fil.arb, not by a native speaker; a native Filipino speaker from the MSWDO should still read it during UAT."
  },
  "profPrivacyKeptTitle": "What this app keeps on your phone",
  "@profPrivacyKeptTitle": {
    "description": "Privacy notice point heading. The Filipino text was written by Claude for D-237, following the terms of app_fil.arb, not by a native speaker; a native Filipino speaker from the MSWDO should still read it during UAT."
  },
  "profPrivacyKeptBody": "Only what is needed to keep you signed in: a sign-in token in your phone’s secure keystore, your first name for the greeting, and whether Taytay LGU has verified you. Signing out removes all of it from this device.",
  "@profPrivacyKeptBody": {
    "description": "Privacy notice point: what is stored on the phone. A factual claim about storage; keep it exact. The Filipino text was written by Claude for D-237, following the terms of app_fil.arb, not by a native speaker; a native Filipino speaker from the MSWDO should still read it during UAT."
  },
  "profPrivacyNeverKeptTitle": "What this app never keeps",
  "@profPrivacyNeverKeptTitle": {
    "description": "Privacy notice point heading. The Filipino text was written by Claude for D-237, following the terms of app_fil.arb, not by a native speaker; a native Filipino speaker from the MSWDO should still read it during UAT."
  },
  "profPrivacyNeverKeptBody": "Your address, date of birth, ID images and household details are not stored on your phone. Screens fetch them when they show them, and nothing is written to a file or a cache.",
  "@profPrivacyNeverKeptBody": {
    "description": "Privacy notice point: what is never stored on the phone. The Filipino text was written by Claude for D-237, following the terms of app_fil.arb, not by a native speaker; a native Filipino speaker from the MSWDO should still read it during UAT."
  },
  "profPrivacyLguHoldsTitle": "What Taytay LGU holds",
  "@profPrivacyLguHoldsTitle": {
    "description": "Privacy notice point heading. The Filipino text was written by Claude for D-237, following the terms of app_fil.arb, not by a native speaker; a native Filipino speaker from the MSWDO should still read it during UAT."
  },
  "profPrivacyLguHoldsBody": "Your municipal resident record: your name, date of birth, address and barangay, together with anything you have applied for. Staff see only what their work requires.",
  "@profPrivacyLguHoldsBody": {
    "description": "Privacy notice point: what the LGU holds. The Filipino text was written by Claude for D-237, following the terms of app_fil.arb, not by a native speaker; a native Filipino speaker from the MSWDO should still read it during UAT."
  },
  "profPrivacyWhoElseTitle": "Who else can see it",
  "@profPrivacyWhoElseTitle": {
    "description": "Privacy notice point heading. The Filipino text was written by Claude for D-237, following the terms of app_fil.arb, not by a native speaker; a native Filipino speaker from the MSWDO should still read it during UAT."
  },
  "profPrivacyWhoElseBody": "Nobody outside Taytay LGU, and no advertiser. Your information is not sold or shared for marketing. Sharing with another government office happens only where the law requires it.",
  "@profPrivacyWhoElseBody": {
    "description": "Privacy notice point: who else can see the data. A legal statement; keep it exact. The Filipino text was written by Claude for D-237, following the terms of app_fil.arb, not by a native speaker; a native Filipino speaker from the MSWDO should still read it during UAT."
  },
  "profPrivacyRightsTitle": "Your rights",
  "@profPrivacyRightsTitle": {
    "description": "Heading of the rights card on the privacy screen. The Filipino text was written by Claude for D-237, following the terms of app_fil.arb, not by a native speaker; a native Filipino speaker from the MSWDO should still read it during UAT."
  },
  "profPrivacyRightsBody": "Under the Data Privacy Act of 2012 you can ask Taytay LGU what it holds about you, ask for a copy, ask for a mistake to be corrected, object to how it is used, and complain to the National Privacy Commission.",
  "@profPrivacyRightsBody": {
    "description": "The data subject's rights under RA 10173. The law's and the commission's names stay in English. The Filipino text was written by Claude for D-237, following the terms of app_fil.arb, not by a native speaker; a native Filipino speaker from the MSWDO should still read it during UAT."
  },
  "profPrivacyRightsHow": "Ask at the Taytay municipal hall with a valid ID. Staff there can act on your record directly. You do not need this app or your phone to do it.",
  "@profPrivacyRightsHow": {
    "description": "How to exercise the rights above. The Filipino text was written by Claude for D-237, following the terms of app_fil.arb, not by a native speaker; a native Filipino speaker from the MSWDO should still read it during UAT."
  },
  "profPrivacyConsentTitle": "Changing what you agreed to.",
  "@profPrivacyConsentTitle": {
    "description": "Bold lead of a note on the privacy screen. A full stop ends it; the body follows on the same line. The Filipino text was written by Claude for D-237, following the terms of app_fil.arb, not by a native speaker; a native Filipino speaker from the MSWDO should still read it during UAT."
  },
  "profPrivacyConsentBody": "The permissions you gave when you registered are held with your Taytay LGU record, not in this app. To change or withdraw one, ask at the municipal hall — that way the change is recorded where it counts.",
  "@profPrivacyConsentBody": {
    "description": "Why consent is not toggled in the app. The Filipino text was written by Claude for D-237, following the terms of app_fil.arb, not by a native speaker; a native Filipino speaker from the MSWDO should still read it during UAT."
  },
  "profPrivacyDeleteTitle": "Deleting your record.",
