<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Debug-only cleartext to the emulator host. See
         res/xml/network_security_config.xml for why this exists and why it names
         two hosts rather than permitting cleartext outright. Merged into debug
         builds only; a release APK carries neither this attribute nor the file. -->
    <application android:networkSecurityConfig="@xml/network_security_config" />
</manifest>
