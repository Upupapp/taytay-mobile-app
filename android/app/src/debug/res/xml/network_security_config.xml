<?xml version="1.0" encoding="utf-8"?>
<!--
    DEBUG ONLY. This file lives in src/debug and is merged into no other build
    type, so a release APK carries none of it.

    Why it is needed: Android has blocked cleartext by default since targetSdk 28,
    and this app's documented dev base URL is http://10.0.2.2:8000 — the
    emulator's route to the host machine, where a local Laravel server runs. So
    the workflow in README.md could not work on Android and would have failed as
    an ordinary-looking network error, which is the kind of thing a developer
    spends an afternoon on before suspecting the platform.

    Why it is scoped to two hosts rather than `cleartextTrafficPermitted="true"`:
    a blanket permission in a debug build is still a debug build somebody
    eventually points at a staging host over http, and then at something real.
    10.0.2.2 is the emulator host and localhost is a device on the same machine;
    neither can be anything but a developer's own laptop.

    Release builds are unaffected and cleartext stays impossible there — which is
    asserted against the built artifact rather than against this file, in
    tool/check_release_hardening.sh.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
